---
// Enlace "Volver" compartido por todas las páginas. Mantiene una sola fuente de
// estilo y posición para la navegación hacia atrás, de modo que se vea igual y
// en el mismo lugar en cada pantalla. Colócalo arriba del <h1> de la página,
// dentro de su mismo contenedor, para que quede alineado con el contenido.
export interface Props {
  href?: string;
  label?: string;
}
const { href = "/", label = "Volver" } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-brand-500 transition-colors"
>
  <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
  </svg>
  {label}
</a>
