---
import Base from "../../../layouts/Base.astro";
import BackLink from "../../../components/BackLink.astro";
const { id } = Astro.params;

const apiUrl = import.meta.env.API_URL || "http://127.0.0.1:8000";
const res = await fetch(`${apiUrl}/jobs/${id}`);
if (!res.ok) return Astro.redirect("/");
const job = await res.json();
const result = job.result || {};
const dry_run = result.dry_run || job.params?.dry_run;

function statusColor(s: string | undefined) {
  if (!s) return "text-gray-400";
  if (s === "published") return "text-green-400";
  if (s === "scheduled") return "text-blue-400";
  if (s === "dry-run") return "text-amber-400";
  if (s === "error" || s?.includes("error")) return "text-red-400";
  return "text-gray-300";
}
---

<Base title="Resultado">
  <div class="max-w-2xl mx-auto">
    <div class="mb-6">
      <BackLink href="/" />
    </div>
    <div class="mb-8">
      {dry_run ? (
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-full bg-amber-900/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white">Dry-run completado</h1>
        </div>
      ) : (
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-full bg-green-900/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white">Publicado</h1>
        </div>
      )}
      <p class="text-gray-400 text-sm">{job.content?.title || "Video de YouTube"}</p>
    </div>

    <div class="space-y-4">
      {result.linkedin && (
        <div class="bg-gray-900 rounded-2xl border border-gray-800 p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span class="font-semibold text-white">LinkedIn</span>
          </div>
          <div class="space-y-3 text-sm">
            <div class="flex gap-2">
              <span class="text-gray-500 w-16 flex-shrink-0">Status</span>
              <span class={statusColor(result.linkedin.status)}>{result.linkedin.status || "—"}</span>
            </div>
            {result.linkedin.url && (
              <a
                href={result.linkedin.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg transition-colors"
              >
                Ver publicación
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
            {result.linkedin.error && (
              <div class="flex gap-2">
                <span class="text-gray-500 w-16 flex-shrink-0">Error</span>
                <span class="text-red-400">{result.linkedin.error}</span>
              </div>
            )}
          </div>
        </div>
      )}

      {result.instagram && (
        <div class="bg-gray-900 rounded-2xl border border-gray-800 p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-pink-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            <span class="font-semibold text-white">Instagram</span>
          </div>
          <div class="space-y-3 text-sm">
            <div class="flex gap-2">
              <span class="text-gray-500 w-16 flex-shrink-0">Status</span>
              <span class={statusColor(result.instagram.status)}>{result.instagram.status || "—"}</span>
            </div>
            {result.instagram.url && (
              <a
                href={result.instagram.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 bg-pink-600 hover:bg-pink-700 text-white font-medium px-4 py-2 rounded-lg transition-colors"
              >
                Ver publicación
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
            {result.instagram.error && (
              <div class="flex gap-2">
                <span class="text-gray-500 w-16 flex-shrink-0">Error</span>
                <span class="text-red-400">{result.instagram.error}</span>
              </div>
            )}
          </div>
        </div>
      )}

      {result.facebook && (
        <div class="bg-gray-900 rounded-2xl border border-gray-800 p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span class="font-semibold text-white">Facebook</span>
          </div>
          <div class="space-y-3 text-sm">
            <div class="flex gap-2">
              <span class="text-gray-500 w-16 flex-shrink-0">Status</span>
              <span class={statusColor(result.facebook.status)}>{result.facebook.status || "—"}</span>
            </div>
            {result.facebook.url && (
              <a
                href={result.facebook.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg transition-colors"
              >
                Ver publicación
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
            {result.facebook.error && (
              <div class="flex gap-2">
                <span class="text-gray-500 w-16 flex-shrink-0">Error</span>
                <span class="text-red-400">{result.facebook.error}</span>
              </div>
            )}
          </div>
        </div>
      )}

      {result.tiktok && (
        <div class="bg-gray-900 rounded-2xl border border-gray-800 p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
            <span class="font-semibold text-white">TikTok</span>
          </div>
          <div class="space-y-3 text-sm">
            <div class="flex gap-2">
              <span class="text-gray-500 w-16 flex-shrink-0">Status</span>
              <span class={statusColor(result.tiktok.status)}>{result.tiktok.status || "—"}</span>
            </div>
            {result.tiktok.url && (
              <a
                href={result.tiktok.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white font-medium px-4 py-2 rounded-lg transition-colors"
              >
                Ver publicación
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
            {result.tiktok.error && (
              <div class="flex gap-2">
                <span class="text-gray-500 w-16 flex-shrink-0">Error</span>
                <span class="text-red-400">{result.tiktok.error}</span>
              </div>
            )}
          </div>
        </div>
      )}
    </div>

    <div class="mt-8 flex gap-3">
      <a href="/" class="flex-1 text-center bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3 px-6 rounded-xl transition-colors">
        Nuevo post
      </a>
    </div>
  </div>
</Base>
