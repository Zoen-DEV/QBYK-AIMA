---
import Base from "../layouts/Base.astro";
---

<Base title="Crear contenido">
  <div class="max-w-3xl mx-auto">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-white mb-2">¿Qué quieres crear?</h1>
      <p class="text-gray-400">Genera posts para LinkedIn, Instagram y Facebook. Elige cómo quieres empezar.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- Card 1: post individual -->
      <a
        href="/individual"
        class="group bg-gray-900 rounded-2xl border border-gray-800 p-7 flex flex-col hover:border-brand-500 hover:bg-gray-900/80 transition-colors"
      >
        <div class="w-12 h-12 rounded-xl bg-brand-500/15 text-brand-500 flex items-center justify-center mb-5 group-hover:bg-brand-500/25 transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-white mb-2">Crear un post</h2>
        <p class="text-sm text-gray-400 leading-relaxed flex-1">
          Llena un formulario y genera un post — imagen única o <strong class="text-gray-300">carrusel</strong> — para LinkedIn, Instagram y Facebook a partir de un video de YouTube, una nota de voz o un documento (texto, PDF o Word). Lo revisas antes de publicar.
        </p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-500">
          Empezar
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </a>

      <!-- Card 2: varios posts con un sheet -->
      <a
        href="/bulk"
        class="group bg-gray-900 rounded-2xl border border-gray-800 p-7 flex flex-col hover:border-brand-500 hover:bg-gray-900/80 transition-colors"
      >
        <div class="w-12 h-12 rounded-xl bg-brand-500/15 text-brand-500 flex items-center justify-center mb-5 group-hover:bg-brand-500/25 transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-white mb-2">Crear varios con un sheet</h2>
        <p class="text-sm text-gray-400 leading-relaxed flex-1">
          Descarga una plantilla, llena una fila por post (hasta 6) con su fecha y hora, súbela y programa todos los posts de una sola vez.
        </p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-500">
          Empezar en lote
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </a>

      <!-- Card 3: Reel de Instagram -->
      <a
        href="/reel"
        class="group bg-gray-900 rounded-2xl border border-gray-800 p-7 flex flex-col hover:border-brand-500 hover:bg-gray-900/80 transition-colors"
      >
        <div class="w-12 h-12 rounded-xl bg-brand-500/15 text-brand-500 flex items-center justify-center mb-5 group-hover:bg-brand-500/25 transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <rect x="3" y="4" width="18" height="16" rx="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-white mb-2">Reel de Instagram</h2>
        <p class="text-sm text-gray-400 leading-relaxed flex-1">
          Publica un Reel vertical (9:16) en Instagram. Genera el video desde una fuente (YouTube, nota de voz, documento o texto) o sube tu propio video. Escribimos el caption por ti.
        </p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-500">
          Crear Reel
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </a>

      <!-- Card 4: Historia de Instagram -->
      <a
        href="/historia"
        class="group bg-gray-900 rounded-2xl border border-gray-800 p-7 flex flex-col hover:border-brand-500 hover:bg-gray-900/80 transition-colors"
      >
        <div class="w-12 h-12 rounded-xl bg-brand-500/15 text-brand-500 flex items-center justify-center mb-5 group-hover:bg-brand-500/25 transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" stroke-dasharray="3 2.5" stroke-linecap="round" />
            <circle cx="12" cy="12" r="3.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-white mb-2">Historia de Instagram</h2>
        <p class="text-sm text-gray-400 leading-relaxed flex-1">
          Publica una Historia vertical (9:16) en Instagram, como imagen o video. Genérala desde una fuente o sube tu propio archivo.
        </p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-500">
          Crear Historia
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>

    <div class="mt-8 text-center">
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-brand-500 transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13h4v8H3v-8zM10 3h4v18h-4V3zM17 9h4v12h-4V9z" />
        </svg>
        Ver dashboard de costos
      </a>
    </div>
  </div>
</Base>
