---
import Base from "../layouts/Base.astro";
---

<Base title="Nuevo post">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Nuevo post</h1>
      <p class="text-gray-400">Genera posts para LinkedIn, Instagram y Facebook a partir de un video de YouTube, una nota de voz, un documento (texto, PDF o Word) o texto escrito manualmente.</p>
    </div>

    <form method="POST" action="/api/jobs" id="job-form" class="space-y-6" enctype="multipart/form-data">
      <!-- Fuente del contenido -->
      <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6 space-y-4">
        <label class="block">
          <span class="text-sm font-medium text-gray-300 mb-2 block">Fuente del contenido <span class="text-red-400">*</span></span>
          <select name="source_type" id="source-type" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition">
            <option value="youtube">Link de YouTube</option>
            <option value="audio">Audio — nota de voz (WhatsApp)</option>
            <option value="texto">Documento (texto, PDF o Word)</option>
            <option value="manual">Manual — escribir texto</option>
          </select>
        </label>

        <!-- YouTube URL -->
        <label class="block" id="src-youtube">
          <span class="text-xs text-gray-400 mb-1 block">URL de YouTube</span>
          <input
            type="url"
            name="youtube_url"
            id="youtube-url"
            placeholder="https://www.youtube.com/watch?v=..."
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
          />
        </label>

        <!-- Archivo (audio o texto) -->
        <label class="block hidden" id="src-file">
          <span class="text-xs text-gray-400 mb-1 block" id="file-label">Archivo</span>
          <input
            type="file"
            name="media_file"
            id="media-file"
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:bg-brand-500 file:text-white file:cursor-pointer hover:file:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 transition"
          />
          <span class="text-[11px] text-gray-500 mt-1.5 block leading-relaxed" id="file-hint"></span>
        </label>

        <!-- Texto manual -->
        <label class="block hidden" id="src-manual">
          <span class="text-xs text-gray-400 mb-1 block">Texto</span>
          <textarea
            name="manual_text"
            id="manual-text"
            rows="6"
            placeholder="Escribe o pega aquí el texto que quieres convertir en posts..."
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition resize-y"
          ></textarea>
          <span class="text-[11px] text-gray-500 mt-1.5 block leading-relaxed">La primera línea se usa como título; el resto es la base para los posts.</span>
        </label>
      </div>

      <!-- Plataformas -->
      <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6 space-y-5">
        <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wider">Configuración</h2>

        <div class="grid grid-cols-2 gap-4">
          <!-- Tono -->
          <label class="block">
            <span class="text-xs text-gray-400 mb-1 block">Tono (ambas redes)</span>
            <select name="tono" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">Auto</option>
              <option value="educativo">Educativo / insights</option>
              <option value="inspiracional">Inspiracional</option>
              <option value="personal">Personal / storytelling</option>
            </select>
          </label>

          <!-- Objetivo -->
          <label class="block">
            <span class="text-xs text-gray-400 mb-1 block">Objetivo (ambas redes)</span>
            <select name="objetivo" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">Auto</option>
              <option value="engagement">Engagement (comentarios)</option>
              <option value="awareness">Awareness (alcance)</option>
              <option value="trafico">Tráfico (al video)</option>
            </select>
          </label>
        </div>

        <!-- Tipo de medio -->
        <label class="block">
          <span class="text-xs text-gray-400 mb-1 block">Tipo de medio</span>
          <select name="tipo_medio" id="tipo-medio" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="imagen">Imagen (LinkedIn + Instagram)</option>
            <option value="video">Video (text-to-video con Higgsfield)</option>
          </select>
          <span class="text-[11px] text-gray-500 mt-1.5 block leading-relaxed">
            <strong class="text-gray-400">Video</strong> genera un clip con Higgsfield (text-to-video, sin texto sobreimpreso) y lo publica en ambas redes. Requiere credenciales de Higgsfield; si no están, se generan imágenes. El video tarda varios minutos.
          </span>
        </label>

        <!-- Fuente de las imágenes (solo aplica a Tipo de medio = Imagen) -->
        <label class="block" id="fuente-imagen-wrap">
          <span class="text-xs text-gray-400 mb-1 block">Fuente de las imágenes</span>
          <select name="fuente_imagen" id="fuente-imagen" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="higgsfield">Higgsfield (con respaldo en plantillas)</option>
            <option value="template">Plantillas directamente</option>
          </select>
          <span class="text-[11px] text-gray-500 mt-1.5 block leading-relaxed">
            <strong class="text-gray-400">Higgsfield</strong> genera imágenes con IA y, si falla, usa las plantillas locales. <strong class="text-gray-400">Plantillas directamente</strong> omite Higgsfield y usa siempre las plantillas (más rápido, sin consumir créditos).
          </span>
        </label>

        <div class="grid grid-cols-2 gap-4">
          <!-- Formato Instagram -->
          <label class="block" id="formato-ig-wrap">
            <span class="text-xs text-gray-400 mb-1 block">Formato Instagram</span>
            <select name="formato_instagram" id="formato-instagram" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="imagen-unica">Imagen única</option>
              <option value="carrusel">Carrusel</option>
            </select>
          </label>

          <!-- Cantidad de slides del carrusel -->
          <label class="block" id="carrusel-slides-wrap">
            <span class="text-xs text-gray-400 mb-1 block">Slides del carrusel</span>
            <select name="carrusel_slides" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="3">3 slides</option>
              <option value="4">4 slides</option>
              <option value="5">5 slides</option>
              <option value="6">6 slides</option>
            </select>
          </label>
        </div>

        <!-- Cuentas de Blotato -->
        <div class="grid grid-cols-2 gap-4" id="accounts-wrap">
          <label class="block">
            <span class="text-xs text-gray-400 mb-1 block">Cuenta de LinkedIn</span>
            <select name="linkedin_account_id" id="linkedin-account" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">Cargando cuentas...</option>
            </select>
          </label>
          <label class="block">
            <span class="text-xs text-gray-400 mb-1 block">Cuenta de Instagram</span>
            <select name="instagram_account_id" id="instagram-account" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">Cargando cuentas...</option>
            </select>
          </label>
          <label class="block">
            <span class="text-xs text-gray-400 mb-1 block">Cuenta de Facebook</span>
            <select name="facebook_account_id" id="facebook-account" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">Cargando cuentas...</option>
            </select>
          </label>
        </div>

        <!-- Página de LinkedIn (aparece solo si la cuenta seleccionada tiene páginas) -->
        <label class="block hidden" id="linkedin-page-wrap">
          <span class="text-xs text-gray-400 mb-1 block">Publicar en LinkedIn como</span>
          <select name="linkedin_page_id" id="linkedin-page" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="">Perfil personal</option>
          </select>
        </label>

        <!-- Página de Facebook (Facebook publica siempre en una Página) -->
        <label class="block hidden" id="facebook-page-wrap">
          <span class="text-xs text-gray-400 mb-1 block">Página de Facebook</span>
          <select name="facebook_page_id" id="facebook-page" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="">Página por defecto</option>
          </select>
        </label>

        <!-- Idioma -->
        <label class="block">
          <span class="text-xs text-gray-400 mb-1 block">Idioma</span>
          <select name="idioma" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="auto">Auto-detectar</option>
            <option value="es">Español</option>
            <option value="en">English</option>
          </select>
        </label>

        <!-- Modelo de redacción (Perplexity) -->
        <label class="block">
          <span class="text-xs text-gray-400 mb-1 block">Modelo de redacción (Perplexity)</span>
          <select name="modelo_perplexity" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="sonar-pro">Sonar Pro — más profundo y mejor calidad (algo más lento y caro)</option>
            <option value="sonar">Sonar — más rápido y económico, calidad estándar</option>
          </select>
          <span class="text-[11px] text-gray-500 mt-1.5 block leading-relaxed">
            <strong class="text-gray-400">Sonar Pro</strong> razona más y suele dar textos más ricos; <strong class="text-gray-400">Sonar</strong> es más veloz y barato para posts simples. Solo aplica si el motor de escritura es Perplexity (si hay clave de Anthropic, se usa Claude e ignora esto).
          </span>
        </label>

        <!-- Opciones avanzadas -->
        <details class="group">
          <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-300 transition list-none flex items-center gap-1">
            <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
            Opciones avanzadas
          </summary>
          <div class="mt-4 space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Tono LinkedIn (override)</span>
                <select name="tono_linkedin" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="">— mismo que global —</option>
                  <option value="educativo">Educativo</option>
                  <option value="inspiracional">Inspiracional</option>
                  <option value="personal">Personal</option>
                </select>
              </label>
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Tono Instagram (override)</span>
                <select name="tono_instagram" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="">— mismo que global —</option>
                  <option value="educativo">Educativo</option>
                  <option value="inspiracional">Inspiracional</option>
                  <option value="personal">Personal</option>
                </select>
              </label>
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Objetivo LinkedIn (override)</span>
                <select name="objetivo_linkedin" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="">— mismo que global —</option>
                  <option value="engagement">Engagement</option>
                  <option value="awareness">Awareness</option>
                  <option value="trafico">Tráfico</option>
                </select>
              </label>
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Objetivo Instagram (override)</span>
                <select name="objetivo_instagram" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="">— mismo que global —</option>
                  <option value="engagement">Engagement</option>
                  <option value="awareness">Awareness</option>
                  <option value="trafico">Tráfico</option>
                </select>
              </label>
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Tono Facebook (override)</span>
                <select name="tono_facebook" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="">— mismo que global —</option>
                  <option value="educativo">Educativo</option>
                  <option value="inspiracional">Inspiracional</option>
                  <option value="personal">Personal</option>
                </select>
              </label>
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Objetivo Facebook (override)</span>
                <select name="objetivo_facebook" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="">— mismo que global —</option>
                  <option value="engagement">Engagement</option>
                  <option value="awareness">Awareness</option>
                  <option value="trafico">Tráfico</option>
                </select>
              </label>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Publicar solo en</span>
                <select name="solo" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="">Todas las plataformas</option>
                  <option value="linkedin">Solo LinkedIn</option>
                  <option value="instagram">Solo Instagram</option>
                  <option value="facebook">Solo Facebook</option>
                </select>
              </label>
              <label class="block">
                <span class="text-xs text-gray-400 mb-1 block">Programar publicación</span>
                <input
                  type="datetime-local"
                  name="publicar"
                  class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
                />
              </label>
            </div>

            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="dry_run" value="true" class="w-4 h-4 rounded bg-gray-800 border-gray-600 text-brand-500 focus:ring-brand-500" />
              <span class="text-sm text-gray-400">Dry-run (generar todo pero no publicar)</span>
            </label>
          </div>
        </details>
      </div>

      <!-- Submit -->
      <button
        type="submit"
        id="submit-btn"
        class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3.5 px-6 rounded-xl transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Generar posts
      </button>
    </form>
  </div>
</Base>

<script>
  const form = document.getElementById("job-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  // Content source switcher: YouTube link vs. uploaded audio/text file.
  // Disabled inputs aren't submitted, so only the active source's field is sent.
  const sourceType = document.getElementById("source-type") as HTMLSelectElement;
  const srcYoutube = document.getElementById("src-youtube") as HTMLElement;
  const srcFile = document.getElementById("src-file") as HTMLElement;
  const srcManual = document.getElementById("src-manual") as HTMLElement;
  const youtubeUrl = document.getElementById("youtube-url") as HTMLInputElement;
  const mediaFile = document.getElementById("media-file") as HTMLInputElement;
  const manualText = document.getElementById("manual-text") as HTMLTextAreaElement;
  const fileLabel = document.getElementById("file-label") as HTMLElement;
  const fileHint = document.getElementById("file-hint") as HTMLElement;

  const FILE_CONFIG: Record<string, { label: string; accept: string; hint: string }> = {
    audio: {
      label: "Audio (.ogg / .opus / .m4a / .mp3 / .wav)",
      accept: "audio/*,.ogg,.opus,.m4a,.mp3,.wav",
      hint: "Sube tu nota de voz de WhatsApp. Se transcribe automáticamente y de ahí se genera el contenido.",
    },
    texto: {
      label: "Documento (.pdf / .docx / .txt / .md)",
      accept:
        ".pdf,.docx,.txt,.md,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown",
      hint: "Sube un PDF, Word (.docx) o texto (.txt / .md); su contenido se usa como base para los posts.",
    },
  };

  const syncSource = () => {
    const v = sourceType.value;
    const isYoutube = v === "youtube";
    const isManual = v === "manual";
    const isFile = !isYoutube && !isManual;
    // Disabled inputs aren't submitted, so only the active source's field is sent.
    srcYoutube.classList.toggle("hidden", !isYoutube);
    srcFile.classList.toggle("hidden", !isFile);
    srcManual.classList.toggle("hidden", !isManual);
    youtubeUrl.disabled = !isYoutube;
    youtubeUrl.required = isYoutube;
    mediaFile.disabled = !isFile;
    mediaFile.required = isFile;
    manualText.disabled = !isManual;
    manualText.required = isManual;
    if (isFile) {
      const cfg = FILE_CONFIG[v];
      mediaFile.accept = cfg.accept;
      fileLabel.textContent = cfg.label;
      fileHint.textContent = cfg.hint;
      mediaFile.value = "";
    }
  };
  sourceType.addEventListener("change", syncSource);
  syncSource();

  // Instagram carousel/single format doesn't apply when generating video.
  const tipoMedio = document.getElementById("tipo-medio") as HTMLSelectElement;
  const formatoWrap = document.getElementById("formato-ig-wrap") as HTMLElement;
  const formatoIg = document.getElementById("formato-instagram") as HTMLSelectElement;
  const slidesWrap = document.getElementById("carrusel-slides-wrap") as HTMLElement;
  const fuenteImagenWrap = document.getElementById("fuente-imagen-wrap") as HTMLElement;

  // Carousel slide count only matters for carousel format (and not for video).
  const syncSlidesState = () => {
    const show = tipoMedio.value !== "video" && formatoIg.value === "carrusel";
    slidesWrap.classList.toggle("opacity-40", !show);
    slidesWrap.classList.toggle("pointer-events-none", !show);
  };

  const syncFormatoState = () => {
    const isVideo = tipoMedio.value === "video";
    formatoWrap.classList.toggle("opacity-40", isVideo);
    formatoWrap.classList.toggle("pointer-events-none", isVideo);
    // La fuente de imágenes no aplica cuando se genera video.
    fuenteImagenWrap.classList.toggle("opacity-40", isVideo);
    fuenteImagenWrap.classList.toggle("pointer-events-none", isVideo);
    syncSlidesState();
  };
  tipoMedio.addEventListener("change", syncFormatoState);
  formatoIg.addEventListener("change", syncSlidesState);
  syncFormatoState();

  // Load connected Blotato accounts into the selectors.
  type LiPage = { id: string; name: string };
  type Account = { id: string; label: string; pages?: LiPage[] };

  const liAccount = document.getElementById("linkedin-account") as HTMLSelectElement;
  const igAccount = document.getElementById("instagram-account") as HTMLSelectElement;
  const fbAccount = document.getElementById("facebook-account") as HTMLSelectElement;
  const liPage = document.getElementById("linkedin-page") as HTMLSelectElement;
  const liPageWrap = document.getElementById("linkedin-page-wrap") as HTMLLabelElement;
  const fbPage = document.getElementById("facebook-page") as HTMLSelectElement;
  const fbPageWrap = document.getElementById("facebook-page-wrap") as HTMLLabelElement;

  // LinkedIn/Facebook accounts kept around so we can look up each account's pages on change.
  let liAccounts: Account[] = [];
  let fbAccounts: Account[] = [];

  function fillSelect(sel: HTMLSelectElement, accounts: Account[], errorMsg?: string) {
    sel.innerHTML = "";
    if (!accounts || accounts.length === 0) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = errorMsg ? `Sin cuentas (${errorMsg})` : "No hay cuentas conectadas";
      sel.appendChild(opt);
      return;
    }
    for (const a of accounts) {
      const opt = document.createElement("option");
      opt.value = a.id;
      opt.textContent = a.label;
      sel.appendChild(opt);
    }
  }

  // Populate the page selector for the currently selected LinkedIn account.
  function updateLinkedinPages() {
    const acc = liAccounts.find((a) => a.id === liAccount.value);
    const pages = acc?.pages ?? [];
    liPage.innerHTML = "";
    const personal = document.createElement("option");
    personal.value = "";
    personal.textContent = "Perfil personal";
    liPage.appendChild(personal);
    for (const p of pages) {
      const opt = document.createElement("option");
      opt.value = p.id;
      opt.textContent = p.name || `Página ${p.id}`;
      liPage.appendChild(opt);
    }
    liPageWrap.classList.toggle("hidden", pages.length === 0);
  }

  // Populate the page selector for the currently selected Facebook account.
  // Facebook publishes to a Page, so when the account has pages we list them and
  // pre-select the first; only when it has none do we fall back to "Página por
  // defecto" (empty → Blotato picks). The selector hides when there are no pages.
  function updateFacebookPages() {
    const acc = fbAccounts.find((a) => a.id === fbAccount.value);
    const pages = acc?.pages ?? [];
    fbPage.innerHTML = "";
    if (pages.length === 0) {
      const def = document.createElement("option");
      def.value = "";
      def.textContent = "Página por defecto";
      fbPage.appendChild(def);
    }
    for (const p of pages) {
      const opt = document.createElement("option");
      opt.value = p.id;
      opt.textContent = p.name || `Página ${p.id}`;
      fbPage.appendChild(opt);
    }
    fbPageWrap.classList.toggle("hidden", pages.length === 0);
  }

  liAccount.addEventListener("change", updateLinkedinPages);
  fbAccount.addEventListener("change", updateFacebookPages);

  (async () => {
    try {
      const res = await fetch("/api/accounts");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      liAccounts = data.linkedin ?? [];
      fbAccounts = data.facebook ?? [];
      fillSelect(liAccount, liAccounts, data.linkedin_error);
      fillSelect(igAccount, data.instagram, data.instagram_error);
      fillSelect(fbAccount, fbAccounts, data.facebook_error);
      updateLinkedinPages();
      updateFacebookPages();
    } catch (e) {
      fillSelect(liAccount, [], String(e));
      fillSelect(igAccount, [], String(e));
      fillSelect(fbAccount, [], String(e));
    }
  })();

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.innerHTML = `<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/></svg> Procesando...`;

    const data = new FormData(form);
    // Convert checkbox: if not checked, don't send; if checked, send as boolean
    if (!data.get("dry_run")) data.delete("dry_run");

    const res = await fetch("/api/jobs", { method: "POST", body: data });
    if (res.ok) {
      const { job_id } = await res.json();
      window.location.href = `/jobs/${job_id}`;
    } else {
      const err = await res.json();
      alert(`Error: ${err.detail || JSON.stringify(err)}`);
      btn.disabled = false;
      btn.innerHTML = "Generar posts";
    }
  });
</script>
