# Copia este archivo a .env y rellena tus credenciales

# Blotato API Key (obligatorio)
# Obtener en: https://my.blotato.com/settings/api
BLOTATO_API_KEY=your_blotato_api_key_here

# LLM para escribir los posts (al menos uno requerido)
# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Perplexity (alternativa, usa sonar-pro) — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Transcripción de audio (requerida SOLO para la fuente "Audio" — notas de voz)
# Motor: "api" (Whisper en la nube, default) o "local" (faster-whisper, gratis).
# TRANSCRIPTION_ENGINE=api
#
# ── Opción gratuita: faster-whisper en local (sin clave, offline) ──────────────
# Pon TRANSCRIPTION_ENGINE=local e instala: pip install faster-whisper
# El modelo se descarga una vez en el primer uso. No hay límite de 25 MB.
# TRANSCRIPTION_ENGINE=local
# TRANSCRIPTION_LOCAL_MODEL=base       # tiny | base | small | medium | large-v3 (mayor = mejor y más lento)
# TRANSCRIPTION_LOCAL_DEVICE=cpu       # cpu | cuda (si tienes GPU NVIDIA)
# TRANSCRIPTION_LOCAL_COMPUTE=int8     # int8 (CPU) | float16 (GPU)
#
# ── Opción API: endpoint Whisper compatible con OpenAI ─────────────────────────
# Con OPENAI_API_KEY basta (default). OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Alternativa: Groq (también compatible con OpenAI). Si lo usas, define la clave
# en GROQ_API_KEY y apunta la base URL y el modelo:
# GROQ_API_KEY=
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_MODEL=whisper-large-v3
# (Overrides opcionales para OpenAI — default whisper-1)
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=whisper-1

# IDs de cuentas para publicar (opcional)
# Si se dejan vacíos, la API los lista automáticamente al primer job.
BLOTATO_LINKEDIN_ACCOUNT_ID=
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_FACEBOOK_ACCOUNT_ID=

# Generación de imágenes (opcional) — Higgsfield Soul
# Si defines AMBAS (key + secret), las imágenes se generan con Higgsfield Soul
# (mejor calidad/realismo, de pago, asíncrono). Si falta cualquiera de las dos,
# o si una generación falla, se usan las PLANTILLAS LOCALES de respaldo
# (api/assets/templates/template-1.png … template-3.png, 1080x1080) con el copy
# superpuesto. Coloca tus 3 plantillas en esa carpeta.
# Credenciales en: https://cloud.higgsfield.ai/
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Overrides opcionales (tienen defaults sensatos):
# HIGGSFIELD_MODEL=higgsfield-ai/soul/standard
# HIGGSFIELD_RESOLUTION=1080p

# Generación de VIDEO (opcional) — Higgsfield text-to-video
# Solo se usa cuando el job pide "tipo de medio: video". Requiere las MISMAS
# credenciales de arriba (HIGGSFIELD_API_KEY + HIGGSFIELD_API_SECRET); no hay
# fallback para video (las plantillas son imágenes, no reemplazan un clip). Si el
# video falla, el job avisa y se queda sin medio en esa publicación.
# Verifica el slug del modelo de video en tu catálogo de Higgsfield y ajústalo aquí:
# HIGGSFIELD_VIDEO_MODEL=higgsfield-ai/text2video/turbo
# HIGGSFIELD_VIDEO_ASPECT=9:16        # 16:9 | 4:3 | 1:1 | 9:16 (un solo clip se comparte LinkedIn+Instagram)
# HIGGSFIELD_VIDEO_DURATION=          # vacío = duración por defecto del modelo

# Dashboard de costos — MongoDB (opcional)
# Persiste los eventos de consumo (usage_events) para el dashboard de gastos.
# Si MONGODB_URI está vacío, el tracking se desactiva silenciosamente: la app
# funciona igual, solo que no registra costos (cero latencia, no rompe el pipeline).
# Local: mongodb://localhost:27017  ·  Atlas: mongodb+srv://usuario:pass@cluster.../
MONGODB_URI=
# Base de datos a usar (default: qbyk_aima)
# MONGODB_DB=qbyk_aima
